rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function meuPerfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function souAdmin() { return logado() && meuPerfil().tipo == 'admin'; }
    function souClienteAprovado() { return logado() && meuPerfil().tipo == 'cliente' && meuPerfil().status == 'aprovado'; }
    // Fecha o achado #2 da engenharia reversa: só o cliente proprietário da obra (ou admin) le suas etapas.
    function souProprietarioObra(obraId) {
      return souClienteAprovado() &&
        get(/databases/$(database)/documents/obras/$(obraId)).data.clienteId == request.auth.uid;
    }
    // Nota 1-5, inteira — usada para validar cada um dos 3 critérios da avaliação (Unidade 3).
    function notaValida(n) { return n is int && n >= 1 && n <= 5; }
    // Avaliação Geral também aceita valores fracionários (é a média dos 3 critérios).
    function geralValida(n) { return n is number && n >= 1 && n <= 5; }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || souAdmin());
      // Fecha o achado #1: autocadastro só pode nascer como cliente pendente;
      // qualquer outro formato (ex.: tipo:'admin', status:'aprovado') exige que quem escreve já seja admin
      // (fluxo usado por cadastrarAdmin, que escreve o perfil do NOVO usuário a partir da sessão do admin original).
      allow create: if logado() && (
        (request.auth.uid == uid && request.resource.data.tipo == 'cliente' && request.resource.data.status == 'pendente') ||
        souAdmin()
      );
      // Autoescrita só pode tocar campos seguros; trocar tipo/status exige ser admin.
      allow update: if souAdmin() ||
        (logado() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'fcmTokens']));
      allow delete: if souAdmin();
    }

    match /obras/{obraId} {
      allow read: if logado();
      allow create, delete: if souAdmin();
      allow update: if souAdmin() ||
        (souClienteAprovado() && resource.data.clienteId == request.auth.uid &&
         !('avaliacaoCriterios' in resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avaliacaoCriterios', 'avaliacaoGeral', 'avaliacaoParceiros', 'avaliacaoComentario', 'avaliadoEm']) &&
         notaValida(request.resource.data.avaliacaoCriterios.tempoExecucao) &&
         notaValida(request.resource.data.avaliacaoCriterios.acabamento) &&
         notaValida(request.resource.data.avaliacaoCriterios.organizacaoLimpeza) &&
         geralValida(request.resource.data.avaliacaoGeral));

      match /etapas/{etapaId} {
        allow read: if souAdmin() || souProprietarioObra(obraId);
        allow create, update, delete: if souAdmin();
      }

      match /encargos/{encargoId} {
        allow read, create, update, delete: if souAdmin();
      }
    }

    match /precos/{precoId} {
      allow read: if logado();
      allow create, update, delete: if souAdmin();
    }

    match /repasses/{repasseId} {
      allow read, create, update, delete: if souAdmin();
    }

    match /diarias/{diariaId} {
      allow read: if logado();
      allow create, update, delete: if souAdmin();
    }

    match /parceiros/{parceiroId} {
      allow read: if logado();
      allow create, update, delete: if souAdmin();

      match /pagamentos/{pagamentoId} {
        allow read: if logado();
        allow create, update, delete: if souAdmin();
      }

      match /notificacoes/{notifId} {
        allow read: if logado();
        allow create, update, delete: if souAdmin();
      }
    }

    match /fechamentos_caixa/{fechamentoId} {
      allow read: if logado();
      allow create, update, delete: if souAdmin();
    }

    match /solicitacoes/{solicitacaoId} {
      allow read: if logado();
      allow create: if souClienteAprovado() && request.resource.data.clienteId == request.auth.uid;
      allow update, delete: if souAdmin();
    }

    match /pagamentos_cliente/{pagId} {
      allow read: if logado();
      allow create: if souClienteAprovado() && request.resource.data.clienteId == request.auth.uid;
      allow update: if souAdmin();
      allow delete: if souAdmin() || (souClienteAprovado() && resource.data.clienteId == request.auth.uid && resource.data.status == 'pendente');
    }

    match /solicitacoes_pagamento/{solId} {
      allow read: if logado();
      allow create, update, delete: if souAdmin();
      allow update: if souAdmin() || (souClienteAprovado() && resource.data.clienteId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'contestacao', 'comprovante', 'formaPagamento', 'dataPagamento']));
    }

    // NOTIFICAÇÕES (feed bidirecional: admin->cliente e cliente->admin)
    match /notificacoes/{notifId} {
      allow read: if souAdmin() ||
        (souClienteAprovado() && resource.data.destinatarioTipo == 'cliente' && resource.data.clienteId == request.auth.uid);
      allow delete: if souAdmin();
      // Admin cria notificações para o cliente (fluxo existente);
      // cliente aprovado só pode criar notificações PARA o admin, com um tipo de uma lista fixa,
      // nascendo não-lida e sem clienteId (formato exclusivo das notificações cliente->admin).
      allow create: if souAdmin() ||
        (souClienteAprovado() &&
         request.resource.data.destinatarioTipo == 'admin' &&
         request.resource.data.tipo in ['solicitacao_criada', 'orcamento_decidido', 'pagamento_cliente_registrado', 'cobranca_respondida', 'avaliacao_registrada'] &&
         request.resource.data.lida == false &&
         !('clienteId' in request.resource.data));
      // Cliente só pode marcar como lida as suas próprias notificações cliente-facing
      allow update: if souAdmin() || (souClienteAprovado() && resource.data.destinatarioTipo == 'cliente' && resource.data.clienteId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']));
    }

    match /orcamentos/{orcId} {
      allow read: if logado();
      allow create, delete: if souAdmin();
      allow update: if souAdmin() || (souClienteAprovado() && resource.data.clienteId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'motivo', 'decididoEm']));
    }
  }
}
